# =====================================================================
# Relais — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : n'y mettez
# jamais de secret.
# =====================================================================

# --- Supabase (obligatoire) ------------------------------------------
# Tableau de bord Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique « publishable » (sb_publishable_…) ou clé « anon » historique.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Application -------------------------------------------------------
# URL publique du site (utilisée pour les liens de suivi et d'invitation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Relais
# Indicatif téléphonique par défaut (Cameroun : 237) pour les liens WhatsApp.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=237
# Centre de carte par défaut « latitude,longitude » (Douala).
NEXT_PUBLIC_DEFAULT_MAP_CENTER=4.0511,9.7679
# Fuseau horaire des statistiques.
NEXT_PUBLIC_TIMEZONE=Africa/Douala

# --- Cartographie --------------------------------------------------------
# Tuiles OpenStreetMap par défaut. Le serveur public OSM est réservé à un
# usage modéré : pour la production, utilisez un fournisseur de tuiles.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap

# Géocodage (recherche d'adresse). Vide = désactivé.
# Nominatim public : 1 requête/s max, identification obligatoire.
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_URL=
GEOCODING_CONTACT=

# Calcul d'itinéraire (OSRM ou compatible). Vide = aucun trajet affiché,
# aucune heure d'arrivée estimée. Le serveur de démonstration OSRM ne doit
# pas être utilisé en production.
ROUTING_URL=

# --- WhatsApp Business (Cloud API) — optionnel, non actif par défaut ------
# Sans ces valeurs, l'application utilise des liens wa.me avec messages
# préremplis (envoi manuel par l'utilisateur).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
